APP_ENV=production
POSTGRES_DB=ipmprs
POSTGRES_USER=ipmprs
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://ipmprs:replace-with-a-long-random-password@localhost:5432/ipmprs
SECRET_KEY=replace-with-a-32-character-or-longer-random-secret
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
DEMO_SEED=false
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=llama3.2
NVIDIA_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
